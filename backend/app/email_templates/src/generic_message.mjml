<mjml>
  <mj-head>
    <mj-title>{{ subject }}</mj-title>
    <mj-preview>{{ preheader }}</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text font-size="14px" line-height="22px" color="#111827" />
      <mj-button background-color="#111827" color="#ffffff" border-radius="6px" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#ffffff" padding="24px">
      <mj-column>
        <mj-text font-size="18px" font-weight="700" padding-bottom="8px">
          {{ app_name }}
        </mj-text>
        <mj-divider border-color="#e5e7eb" />
        <mj-text font-size="16px" font-weight="700" padding-top="12px">
          {{ heading }}
        </mj-text>
        <mj-text padding-top="8px">
          {{ body_html | safe }}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="16px 24px">
      <mj-column>
        <mj-divider border-color="#e5e7eb" />
        <mj-text font-size="12px" color="#6b7280">
          This email was sent by {{ app_name }}. If you did not expect this message, you can ignore it.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
